# Geral
NODE_ENV=production
PORT=3002
PROVIDER_DEFAULT=openstreetmap   # openstreetmap | google | mapbox | mapquest | locationiq | opencage | here

# Chaves dos providers (preencha somente as que for usar)
GOOGLE_API_KEY=
MAPBOX_API_KEY=
MAPQUEST_API_KEY=
LOCATIONIQ_API_KEY=
OPENCAGE_API_KEY=
HERE_API_KEY=

# User-Agent / contato (importante para OSM/Nominatim)
OSM_USER_AGENT=geocoder_reverse@example.com

# Segurança (proteja o endpoint público usando um token simples)
# Para usar, valide este token no n8n ou em requisições (opcional - implementar verificação no server se desejar)
AUTH_TOKEN=changeme_set_a_secret_token_here

# Cache / rate limiting (opcionais)
CACHE_ENABLED=false
CACHE_TTL=3600           # segundos
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60        # max requests por window

# Logs
LOG_LEVEL=info

# Redis (opcional, só se for usar cache externo)
REDIS_URL=

# Notas:
# - Preencha as chaves de API acima conforme o provider que escolher.
# - Troque AUTH_TOKEN por um token forte antes de expor o serviço.
# - O EasyPanel pede as variáveis no painel da app; cole cada linha KEY=VALUE.
